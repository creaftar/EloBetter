---
import "@/assets/styles/fontawesome/css/all.min.css";
import "@/assets/styles/layout/BaseLayout.css";
import "@/assets/styles/global.css";

import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { getAbsoluteLocaleUrl } from 'astro:i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: string;
}

const idiomaAtual = Astro.currentLocale || "en-us";

const { 
  title = "EloBetter - Aprenda a Subir de Elo no League of Legends", 
  description = "Cansado de trolls, afk's e smurfs? Aprenda a subir de elo de verdade com este guia extremamente compacto, sem enrolações.", 
  keywords = "elo, league of legends, como subir de elo no lol, como sair do prata",
  lang="en-us"
} = Astro.props as Props;

// 1. Array exato com os códigos dos idiomas suportados pelo seu site
const todosOsIdiomas = [
  "en-us", "en-gb", "en-au", "pt-br", "es-mx", "es-es", "ko-kr", "ja-jp",
  "tr-tr", "vi-vn", "de-de", "fr-fr", "it-it", "pl-pl", "el-gr", "ro-ro",
  "hu-hu", "cs-cz", "ru-ru", "en-sg", "en-ph", "th-th", "zh-tw", "ar-ae"
];

// 2. Descobre qual é a subpágina atual limpando o prefixo do idioma da URL
const padraoIdioma = new RegExp(`^/(${todosOsIdiomas.join('|')})`);
const subCaminhoLimpo = Astro.url.pathname.replace(padraoIdioma, '').replace(/\/$/, '') || '/';

// 3. Define a URL base para as tags absolutas
const urlSite = "https://elobetter.com"; 

// 4. Gera as URLs absolutas corretas sem barras no final
const urlCanonica = getAbsoluteLocaleUrl(idiomaAtual, subCaminhoLimpo).replace(/\/$/, "");
const urlDefaultX = getAbsoluteLocaleUrl('en-us', subCaminhoLimpo).replace(/\/$/, "");

import fs from 'node:fs';
import path from 'node:path';

const scriptPath = path.resolve('./src/assets/scripts/tema.js');
const estiloPath = path.resolve('./src/assets/styles/tema.css');

const scriptCritico = fs.readFileSync(scriptPath, 'utf-8');
const estiloCritico = fs.readFileSync(estiloPath, 'utf-8');
---

<!DOCTYPE html>
<html lang={idiomaAtual}>
    <head>
        
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        
        <link rel="preconnect" href="https://ddragon.leagueoflegends.com" crossorigin>
        <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin>
        <link rel="preconnect" href="https://wsrv.nl" crossorigin>

        <meta name="generator" content={Astro.generator} />
        
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="robots" content="index, follow" />

        <link rel="canonical" href={urlCanonica == urlSite ? urlSite : urlCanonica + '/'} />

        {todosOsIdiomas.map((idioma) => {
            const urlTraduzida = getAbsoluteLocaleUrl(idioma, subCaminhoLimpo).replace(/\/$/, "");
            return <link rel="alternate" hreflang={idioma} href={urlTraduzida == urlSite ? urlSite : urlTraduzida + '/'} />;
        })}

        <link rel="alternate" hreflang="x-default" href={urlDefaultX} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={urlCanonica} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={`${urlSite}/assets/imgs/icon-light.svg`} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={urlCanonica} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={`${urlSite}/assets/imgs/icon-light.svg`} />

        <link rel="icon" type="image/svg+xml" href="/assets/imgs/icon-light.svg" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/svg+xml" href="/assets/imgs/icon.svg" media="(prefers-color-scheme: dark)" />
        <link rel="icon" href="https://elobetter.com/favicon.svg" type="image/svg+xml">

        <meta name="yandex-verification" content="1050a66f9dcb444c" />
        <meta name="google-adsense-account" content="ca-pub-3201959726673479">

        <style is:inline set:html={estiloCritico} />
        <script is:inline set:html={scriptCritico} />


        <script type="text/javascript">
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "xiblp5qped");
        </script>
    </head>
    <body>
        <Nav lang={idiomaAtual} />
        <main id="content-bl-body">
          <slot></slot>
        </main>
        <Footer lang={idiomaAtual} />
    </body>
</html>