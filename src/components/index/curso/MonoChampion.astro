---
import "@/assets/styles/pages/index/curso/monochampion.css";
import "@/assets/styles/pages/index/curso/curso.css";

const { lang = "pt-br" } = Astro.props;

const t = await import(`../../../i18n/pages/index/curso/monochampion/${lang}.json`).then(m => m.default);
---

<div class="container-monochampion">
    <img src="/assets/imgs/background/truedamage.svg" 
    alt="League of Legends Shadow Background"
    id="truedamage-bg"
    >
    <div class="container-conteudo">
        <h3 set:html={t.title || "Aprendendo com <span class='destaque'>UM</span> Campeão"}></h3>
        <ol>
            <li class="li-monochampion" set:html={t.step_1 || "Descubra apenas <span class='destaque'>UM</span> campeão e apenas <span class='destaque'>UMA</span> lane pra você focar seus esforços"}></li>
            <li class="li-monochampion" set:html={t.step_2 || "Feito o passo anterior, você vai ver vídeos e/ou streams do personagem escolhido"}></li>
            <li class="li-monochampion" set:html={t.step_3 || "Ao ver as streams, foque nas dicas que quem você está assistindo passa"}></li>
            <li class="li-monochampion" set:html={t.step_4 || "Tente aplicar o que foi aprendido nas streams em seus jogos"}></li>
        </ol>
        <div class="container-buttons-monochampions">
            <button id="next-step-monochampion" class="next-step">{t.btn_next || "PRÓXIMO PASSO"}</button>
            <button id="reset-step-monochampion" class="next-step"><i class="fa-solid fa-rotate-left"></i></button>
        </div>
    </div>
</div>

<script>
    import "@/assets/scripts/index/curso/monochampion.js";
</script>