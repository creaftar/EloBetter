---
import "@/assets/styles/pages/index/curso/mentalidade.css";
import "@/assets/styles/pages/index/curso/curso.css";
import Image from "astro/components/Image.astro";

import chatConfig from "@/assets/imgs/prints/chat_config.png";
---

<div class="container-mentalidade">
    <h3 class="destaque" id="mentalidade">A Mentalidade Correta</h3>
    <div class="container-destaque">
        <h4 id="card-principal-mentalidade" class="quadrado-mentalidade mentalidade-ativa card-mentalidade">O que é a Desestabilização Emocional (tiltar)</h4>
    </div>
    <div class="container-cards-mentalidade">
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade">O Mecanismo</span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade">O Impacto</span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade">Quando ocorre</span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade">O que fazer</span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
    </div>
    <div class="container-img-mentalidade">
        <p id="aviso-mentalidade">⚠️ Em todos os seus jogos você vai mutar o chat (tanto aliado
        quanto inimigo) e mutar os emotes inimigos para evitar distrações</p>
        <Image 
            src={chatConfig}
            width={656}
            height={300}
            alt="How to mute the game chat"
            id="img-mentalidade"
        />
        <p id="aviso-img-mentalidade">Mantenha essa configuração acima (certifique-se de também marcar a caixa de emotes)</p>
    </div>
    <button id="reset-step-mentalidade" class="next-step ns-black"><i class="fa-solid fa-rotate-left"></i></button>
</div>

<script>
    import "@/assets/scripts/index/curso/mentalidade";
</script>