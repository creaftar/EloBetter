---
import "@/assets/styles/pages/index/curso/mentalidade.css";
import "@/assets/styles/pages/index/curso/curso.css";
import Image from "astro/components/Image.astro";

import chatConfig from "@/assets/imgs/prints/chat_config.png";

const { lang = "pt-br" } = Astro.props;

const t = await import(`../../../i18n/pages/index/curso/mentalidade/${lang}.json`).then(m => m.default);
const tc = await import(`../../../i18n/pages/index/curso/curso/${lang}.json`).then(m => m.default);
---

<div class="container-mentalidade" 
  data-translations={JSON.stringify(t.js_texts)}
  id="traducao-mentalidade"
  >
    <h3 class="destaque" id="mentalidade" set:html={t.title || "A Mentalidade Correta"}></h3>
    <div class="container-destaque">
        <h4 id="card-principal-mentalidade" class="quadrado-mentalidade mentalidade-ativa card-mentalidade" set:html={t.main_card_title || "O que é a Desestabilização Emocional (tiltar)"}></h4>
    </div>
    <div class="container-cards-mentalidade">
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade" set:html={t.card_1_title || "O Mecanismo"}></span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade" set:html={t.card_2_title || "O Impacto"}></span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade" set:html={t.card_3_title || "Quando ocorre"}></span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
        <div class="card-mentalidade quadrado-mentalidade">
            <span class="destaque titulo-quadrado-mentalidade" set:html={t.card_4_title || "O que fazer"}></span>
            <p class="texto-quadrado-mentalidade"></p>
        </div>
    </div>
    <div class="container-img-mentalidade">
        <p id="aviso-mentalidade" set:html={t.warning_text || "⚠️ Em todos os seus games você vai mutar o chat (tanto aliado quanto inimigo) e mutar os emotes inimigos para evitar distrações"}></p>
        <Image 
            src={chatConfig}
            width={656}
            height={300}
            alt={t.img_alt || "How to mute the game chat"}
            id="img-mentalidade"
        />
        <p id="aviso-img-mentalidade" set:html={t.img_subtext || "Mantenha essa configuração acima (certifique-se de também marcar a caixa de emotes)"}></p>
    </div>
    
        <div class="container-buttons-mentalidade">
            <button id="next-step-mentalidade" class="next-step ns-alternativo">{tc.btn_next || "PRÓXIMO PASSO"}</button>
            <button id="reset-step-mentalidade" class="reset-step ns-alternativo"><i class="fa-solid fa-rotate-left"></i></button>
        </div>
</div>

<script>
    import "@/assets/scripts/index/curso/mentalidade";
</script>